# Minecraft Java 26.2 LAN world
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=JevOllama
MC_VERSION=26.2
# Open-to-LAN/private local worlds normally use offline auth.
# If your target server requires a real Microsoft account, change this to microsoft.
MC_AUTH=offline

# Local planner (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Thinking is disabled for realtime planning. Qwen3 and other reasoning models can be much faster this way.
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=60000
PLANNER_EVERY_N_ACTIONS=12

# Optional bulk benchmark settings:
# BENCH_MODELS=qwen3:1.7b,qwen3:4b,qwen3:8b
# BENCH_RUNS=1
# BENCH_TIMEOUT_MS=45000
# BENCH_THINK=false

# JEV decision API (native TypeSafe API)
JEV_BASE_URL=https://api.typesafe.ai
JEV_PATH=/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=

# Agent
ACTION_TIMEOUT_MS=20000
LOG_DIR=./runs

# Dream-RSI-inspired replay/self-improvement layer
DREAM_RSI_ENABLED=true
DREAM_RSI_DIR=./dream-rsi
# Every N executed actions, propose/evaluate exploration-policy variants offline.
DREAM_RSI_DREAM_EVERY=40
# Do not start policy improvement until enough transitions have been collected.
DREAM_RSI_MIN_HISTORY=25
DREAM_RSI_MAX_HISTORY=5000
DREAM_RSI_PROPOSALS=4
# Candidate must beat incumbent replay score by at least this amount.
DREAM_RSI_MIN_IMPROVEMENT=0.03
